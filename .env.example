# ============================================================
# Deskbooking – Konfiguration
# Kopieren nach ".env" und Werte anpassen. Diese Datei NIE
# mit echten Secrets ins Git-Repository committen.
# ============================================================

# --- Domain (TLS uebernimmt dein bestehender Caddy-Server, siehe caddy-snippet.txt) ---
DOMAIN=desks.deine-domain.de
PUBLIC_URL=https://desks.deine-domain.de
ENVIRONMENT=production

# Hinweis: Das externe Proxy-Netzwerk heisst fest "webnet" (siehe docker-compose.yml,
# wie bei deinem Toolbox-Setup) - falls dein Caddy in einem anders benannten Netzwerk
# laeuft, in docker-compose.yml bei "networks: webnet:" den Namen anpassen.

# --- Datenbank ---
POSTGRES_DB=deskbooking
POSTGRES_USER=deskbooking
# Starkes, zufaelliges Passwort erzeugen z.B. mit: openssl rand -base64 32
# Sonderzeichen (@ # % / : ?) sind erlaubt - sie werden vor dem Einsetzen in die
# Verbindungs-URL automatisch kodiert (siehe config.py).
# NICHT verwenden: " ' und $ - diese werden von Docker Compose und dem
# Python-Parser unterschiedlich behandelt, was zu schwer auffindbaren
# Auth-Fehlern fuehren kann. Sicher generieren mit:
#   openssl rand -base64 32 | tr -d '=+/'
POSTGRES_PASSWORD=CHANGE_ME

# --- Auth / JWT ---
# Erzeugen mit: openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME_RANDOM_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Erst-Administrator (wird beim ersten Start automatisch angelegt) ---
ADMIN_EMAIL=admin@deine-domain.de
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=Administrator
# Optional: statt ADMIN_PASSWORD einen fertigen Argon2-Hash eintragen, dann
# steht das Klartext-Passwort nirgends in dieser Datei. Ist er gesetzt, wird
# ADMIN_PASSWORD ignoriert. Erzeugen mit:
#   docker compose run --rm --no-deps backend python -c \
#     "from argon2 import PasswordHasher; print(PasswordHasher().hash('DEIN-PASSWORT'))"
ADMIN_PASSWORD_HASH=

# --- Customizing (kein festes Branding, alles hier steuerbar) ---
# Hinweis: Diese Werte sind nur die VORGABE. Admins koennen Farben spaeter im
# Einstellungs-Menue (Zahnrad) aendern; das wird in der Datenbank gespeichert
# und ueberschreibt die Werte hier. "Zuruecksetzen" stellt sie wieder her.
APP_NAME=Deskbooking

# Akzentfarbe: Buttons, Auswahl, freie Plaetze, Ampel.
PRIMARY_COLOR=#A3E635

# Verlauf (links -> Mitte -> rechts). Voellig unabhaengig von PRIMARY_COLOR.
GRADIENT_FROM=#1E5799
GRADIENT_MID=#F300FF
GRADIENT_TO=#E0FF00

# Farbe des dezenten Scheins im Seitenhintergrund - ebenfalls eigenstaendig.
AMBIENT_COLOR=#34D399

LOGO_URL=
SUPPORT_CONTACT=

# --- E-Mail-Benachrichtigungen (optional) ---
# Komplett optional: SMTP_HOST leer lassen, dann verschickt Deskbooking
# keine E-Mails und alles laeuft wie gehabt nur ueber die In-App-Badges.
# Erst mit gesetztem SMTP_HOST wird der Versand aktiv - dann bei neuer
# Direktnachricht oder Erwaehnung im Team-Chat, aber nur wenn die Person
# gerade nicht in der App aktiv ist. Jede Person kann das zusaetzlich
# individuell in ihren Kontoeinstellungen abschalten.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Absenderadresse; leer = SMTP_USER wird verwendet
SMTP_FROM=
SMTP_USE_TLS=true
# Mindestabstand in Minuten zwischen zwei Benachrichtigungs-Mails an
# dieselbe Person (verhindert eine Mail pro Nachricht bei einer laengeren
# Unterhaltung, waehrend jemand offline ist).
EMAIL_NOTIFY_COOLDOWN_MINUTES=10

# --- Buchungsregeln ---
# Max. Dauer einer einzelnen Konferenztisch-Buchung in Stunden. 0 = kein
# Limit. In der Oberflaeche (Einstellungen-Menue) zur Laufzeit aenderbar.
MAX_MEETING_HOURS=4
